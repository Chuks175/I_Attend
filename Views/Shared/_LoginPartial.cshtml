@* @using Microsoft.AspNetCore.Identity *@

@if (Context.Session.GetString("UserId") != null)
{
    <ul class="navbar-nav">
        <li class="nav-item">
            <span class="nav-link text-dark">Welcome, @Context.Session.GetString("UserId")</span>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" href="/Views/Logout">Logout</a>
        </li>
    </ul>
}
else
{
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link text-dark" href= "/Views/Login">Login</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" href="/Views/Register">Register</a>
        </li>
    </ul>
}